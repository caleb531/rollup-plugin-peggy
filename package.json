{
  "name": "rollup-plugin-peggy",
  "version": "6.2.0",
  "description": "Import PEG.js grammars as parsers directly in your code via Peggy, the PEG.js successor",
  "author": "Caleb Evans",
  "license": "MIT",
  "homepage": "https://github.com/caleb531/rollup-plugin-peggy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/caleb531/rollup-plugin-peggy.git"
  },
  "main": "dist/index.cjs.js",
  "module": "dist/index.es.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "rollup -c",
    "prepare": "rollup -c",
    "test": "vitest run",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@rollup/pluginutils": "^5.5.1"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.1",
    "@vitest/coverage-v8": "5.1.1",
    "peggy": "^5.1.1",
    "prettier": "^3.10.1",
    "rollup": "^4.68.7",
    "rollup-plugin-dts": "^6.5.1",
    "tslib": "^2.9.1",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1"
  },
  "peerDependencies": {
    "peggy": ">=1.2.0",
    "rollup": ">=2.0.0"
  },
  "keywords": [
    "pegjs",
    "peggy",
    "rollup-plugin",
    "vite-plugin"
  ],
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12.0.0",
      "onFail": "ignore"
    }
  }
}
